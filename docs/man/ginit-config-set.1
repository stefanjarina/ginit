.SH NAME
ginit-config-set - Set a configuration key to a value


.SH SYNOPSIS
\fBginit config set (defaultbranch  | protocol ssh|https |   ) [flags]\fP


.SH DESCRIPTION
Set a configuration key to a value.

.PP
Use "defaultbranch " to set the branch that git init uses.
Use "protocol ssh" or "protocol https" to choose the clone URL used for origin
in every provider. Unset, it is ssh except on Windows, where it is https.
Otherwise set  on  (token, baseurl, or a provider option).


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for set


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--accessibility\fP[=false]
	Enable accessibility features

.PP
\fB--config\fP=""
	config file (default is $HOME/.config/ginit/ginit.yaml)

.PP
\fB--no-color\fP[=false]
	Disable colored output

.PP
\fB-v\fP, \fB--verbose\fP[=false]
	Enable verbose output (full error chains)


.SH EXAMPLE
.EX
  ginit config set defaultbranch trunk
  ginit config set protocol https
  ginit config set github token <token>
.EE


.SH SEE ALSO
\fBginit-config(1)\fP


